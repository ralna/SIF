VARIABLES

 DO t         1                        T+1
 X  ksi(t)                             $ welfare
 X  gam(t)                             $ debt
 OD t

*   capital (for each sector)

 DO t         1                        T+1
 DO i         1                        4
 X  K(t,i)                   
 OD i
 OD t

 DO t         1                        T
 DO i         1                        4
 X  Q(t,i)                             $ output
 X  C(t,i)                             $ consumption
 X  del(t,i)                           $ investment
 X  L(t,i)                             $ labor
 OD i
 OD t

*   imports (for 2 sectors only)

 DO t         1                        T
 X  M2(t)
 X  M3(t)
 OD t

GROUPS

*   welfare is a function of consumptions

 DO t         1                        T
 IA t+1       t         1
 XE XI(t)     ksi(t+1)  1.0            ksi(t)    -1.0
 OD t

*   capital is function of previous capital and investment 

 DO t         1                        T
 DO i         1                        4
 IA t+1       t         1
 A= aux1      mu(i)     
 RM coef1     aux1      -1.0
 XE KK(t,i)   K(t+1,i)  1.0
 ZE KK(t,i)   K(t,i)                   coef1
 OD i
 OD t

*   debt is function of previous debt, output, investment and imports

 RA 1+theta   theta     1.0
 RM -1-theta  1+theta   -1.0
 DO t         1                        T
 IA t+1       t         1
 XE GG(t)     gam(t+1)  1.0
 ZE GG(t)     gam(t)                   -1-theta
 DO i         1                        4
 AM coef      d(i)      -1.0
 ZE GG(t)     Q(t,i)                   coef
 AM coef      pi(i)     -1.0
 ZE GG(t)     del(t,i)                 coef
 OD i
 XE GG(t)     M2(t)     -1.0           M3(t)     -1.0
 OD t

*   output is function of capital and labor

 DO t         1                        T
 DO i         1                        4
 XE QQ(t,i)
 OD i
 OD t

*   consumption is function of output, investments and imports

 DO t         1                        T
 DO i         1                        4
 DO j         1                        4
 ZE CC(t,i)   Q(t,j)                   PP(i,j)
 ZE CC(t,i)   del(t,j)                 BB(i,j)
 OD j
 OD i
 XE CC(t,2)   M2(t)     -1.0          
 XE CC(t,3)   M3(t)     -1.0          
 OD t

*   constraint on labor
 DO t         1                        T
 DO i         1                        4
 XE LL(t)     L(t,i)    1.0
 OD i
 OD t

CONSTANTS

 DO t         1                        T
 RE aux                 0.0
 DO i         1                        4
 A+ aux       aux                      ee(t,i)
 OD i
 RM aux       aux       -1.0
 ZE KTMODEL   GG(t)                    aux
 OD t

 DO t         1                        T
 DO i         1                        4
 AM aux       ee(t,i)   -1.0
 ZE KTMODEL   CC(t,i)                  aux
 OD i
 OD t

 RA 1+alpha   alpha     1.0
 RE aux                 1.0
 DO t         1                        T
 R* coef      lo                       aux
 ZE KTMODEL   LL(t)                    coef
 R* aux       aux                      1+alpha
 OD t

BOUNDS

 ZX KTMODEL   K(1,1)                   K11
 ZX KTMODEL   K(1,2)                   K12
 ZX KTMODEL   K(1,3)                   K13
 ZX KTMODEL   K(1,4)                   K14
 ZX KTMODEL   K(T,1)                   K1star
 ZX KTMODEL   K(T,2)                   K2star
 ZX KTMODEL   K(T,3)                   K3star
 ZX KTMODEL   K(T,4)                   K4star
 XX KTMODEL   ksi(1)    0.0
 XX KTMODEL   gam(1)    0.0
 ZX KTMODEL   gam(T)                   gammastar
 XX KTMODEL   L(1,1)    5.1
 XX KTMODEL   L(1,2)    0.84
 XX KTMODEL   L(1,3)    0.36
 XX KTMODEL   L(1,4)    2.3
 DO t         1                        T
 DO i         1                        4
 ZL KTMODEL   C(t,i)                   COLO
 OD i
 OD t
 DO t         2                        T-1
 XR KTMODEL   gam(t)                 
 OD t

